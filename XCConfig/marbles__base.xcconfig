MACOSX_DEPLOYMENT_TARGET = 10.14
SDKROOT = macosx
ARCHS = $(ARCHS_STANDARD)
VALID_ARCHS = $(ARCHS_STANDARD)
ONLY_ACTIVE_ARCH = YES
OTHER_CFLAGS = -DDEBUG_LOGGING_OFF -DTARGET_APPLE
COMBINE_HIDPI_IMAGES = NO

GCC_C_LANGUAGE_STANDARD = c17
CLANG_CXX_LANGUAGE_STANDARD = c++2a
CLANG_CXX_LIBRARY = libc++

CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_OBJC_WEAK = YES

// static analyzer
RUN_CLANG_STATIC_ANALYZER = YES
CLANG_STATIC_ANALYZER_MODE = Deep
CLANG_ANALYZER_SECURITY_FLOATLOOPCOUNTER = YES
CLANG_ANALYZER_SECURITY_INSECUREAPI_RAND = NO
CLANG_ANALYZER_SECURITY_INSECUREAPI_STRCPY = YES

WARNING_CFLAGS = -Weverything -Wno-c++98-compat -Wno-c++98-compat-pedantic -Wno-undef -Wno-gnu-zero-variadic-macro-arguments -Wno-format-nonliteral -ftime-trace
